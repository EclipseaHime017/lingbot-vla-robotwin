#!/bin/bash
# Prepare the pinned background textures used by demo_randomized evaluation.
#PBS -N lrvla-random-assets
#PBS -P personal
#PBS -q normal
#PBS -l select=1:ncpus=4:mem=16gb
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -m n
set -euo pipefail
umask 077
: "${PBS_JOBID:?Submit through PBS, not on a login node}"
: "${PBS_O_WORKDIR:?PBS submission directory is missing}"
cd "$PBS_O_WORKDIR"
mkdir -p artifacts/pbs-evaluation
exec >> "artifacts/pbs-evaluation/${PBS_JOBID}.log" 2>&1
printf 'Randomized asset setup %s on %s at %s\n' "$PBS_JOBID" "$(hostname)" "$(date -Is)"
export CONDA_ROOT="${CONDA_ROOT:-${HOME}/miniconda3}"
export PYTHONUNBUFFERED=1
"${CONDA_ROOT}/bin/python" - <<'DOWNLOAD_BACKGROUND'
import importlib.util, json
from pathlib import Path
from urllib.parse import quote
root = Path.cwd()
spec = importlib.util.spec_from_file_location('download_assets', root / 'scripts/download_assets.py')
download = importlib.util.module_from_spec(spec)
spec.loader.exec_module(download)
plan = json.loads((root / 'artifacts/download_sim.json').read_text())
source = plan['sources'][0]
item = next(item for item in source['files'] if item['rfilename'] == 'background_texture.zip')
url = f"https://huggingface.co/datasets/{source['repo']}/resolve/{source['revision']}/{quote(item['rfilename'])}"
result = download.download_file(url, root / 'data/sim_archives' / item['rfilename'], item['size'], item['lfs']['sha256'])
(root / 'artifacts/download_sim_background.json').write_text(json.dumps({
    'repo': source['repo'], 'revision': source['revision'], 'download': result,
}, indent=2) + '\n')
DOWNLOAD_BACKGROUND
"${CONDA_ROOT}/bin/python" scripts/prepare_sim_assets.py --files background_texture.zip
"${CONDA_ROOT}/bin/python" - <<'READY'
from pathlib import Path
from datetime import datetime, timezone
import json, os
root = Path.cwd()
textures = root / 'vendor/RoboTwin/assets/background_texture'
for setting in ('seen', 'unseen'):
    if not (textures / setting).is_dir() or not next((textures / setting).glob('*.png'), None):
        raise RuntimeError(f'Missing official background textures: {setting}')
Path('artifacts/nscc-randomized-assets-ready.json').write_text(json.dumps({
    'ok': True, 'job_id': os.environ['PBS_JOBID'],
    'generated_at': datetime.now(timezone.utc).isoformat(),
    'setting': 'demo_randomized', 'archive': 'background_texture.zip',
}, indent=2) + '\n')
READY
