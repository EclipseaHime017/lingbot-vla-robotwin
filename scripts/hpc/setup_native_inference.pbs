#!/bin/bash
# Add the pinned official FlashAttention package without changing Torch/deps.
#PBS -N lrvla-native-setup
#PBS -P personal
#PBS -q normal
#PBS -l select=1:ncpus=4:mem=32gb
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -m n
set -euo pipefail
umask 077
: "${PBS_JOBID:?Submit through PBS, not on a login node}"
: "${PBS_O_WORKDIR:?PBS submission directory is missing}"
cd "$PBS_O_WORKDIR"
mkdir -p artifacts/pbs-evaluation bootstrap .cache/pip
exec >> "artifacts/pbs-evaluation/${PBS_JOBID}.log" 2>&1
printf 'Native inference setup %s on %s at %s\n' "$PBS_JOBID" "$(hostname)" "$(date -Is)"
set +u
if ! type module >/dev/null 2>&1; then
  source /opt/cray/pe/modules/default/init/bash
fi
module load git/2.39.2 cuda/12.8.1 gcc/11.2.0
set -u
export CONDA_ROOT="${CONDA_ROOT:-${HOME}/miniconda3}"
export CUDA_HOME="$(dirname "$(dirname "$(command -v nvcc)")")"
export CXX="$(command -v g++)"
export CC="$(command -v gcc)"
export MAX_JOBS=4
export NVCC_THREADS=1
export FLASH_ATTN_CUDA_ARCHS=80
export TORCH_CUDA_ARCH_LIST=8.0
export PIP_CACHE_DIR="$PWD/.cache/pip"
export PYTHONNOUSERSITE=1
export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS=4
ulimit -c 0
inference_python="${CONDA_ROOT}/envs/lingbot-vla/bin/python"
wheel='flash_attn-2.8.3+cu12torch2.8cxx11abiTRUE-cp312-cp312-linux_x86_64.whl'
wheel_ready=0
if [[ -f "bootstrap/${wheel}" ]] || /usr/bin/curl -fL --retry 3 \
  "https://github.com/Dao-AILab/flash-attention/releases/download/v2.8.3/${wheel}" -o "bootstrap/${wheel}"; then
  if "$inference_python" -m pip install --no-deps "bootstrap/${wheel}" && \
    "$inference_python" -c 'import flash_attn, torch; assert flash_attn.__version__ == "2.8.3"; print("Official FlashAttention wheel imports", flash_attn.__version__, torch.__version__)'; then
    wheel_ready=1
  fi
fi
if [[ "$wheel_ready" != 1 ]]; then
  printf 'Official wheel unavailable or incompatible; building pinned Ampere sm80 source.\n'
  "$inference_python" -m pip uninstall -y flash-attn
  source_dir="$PWD/bootstrap/flash-attention-v2.8.3"
  if [[ ! -d "${source_dir}/.git" ]]; then
    git clone --recursive --depth 1 --shallow-submodules --branch v2.8.3 \
      https://github.com/Dao-AILab/flash-attention.git "$source_dir"
  fi
  [[ "$(git -C "$source_dir" describe --tags --exact-match)" == v2.8.3 ]]
  export FLASH_ATTENTION_FORCE_BUILD=TRUE
  "$inference_python" -m pip install "$source_dir" --no-build-isolation --no-deps
  "$inference_python" -c 'import flash_attn; assert flash_attn.__version__ == "2.8.3"; print("Source-built FlashAttention imports", flash_attn.__version__)'
fi
"$inference_python" - <<'READY'
from datetime import datetime, timezone
from pathlib import Path
import importlib.metadata, json, os, torch
assert torch.__version__.split('+')[0] == '2.8.0', torch.__version__
assert torch.version.cuda == '12.8', torch.version.cuda
Path('artifacts/nscc-native-inference-ready.json').write_text(json.dumps({
    'ok': True, 'job_id': os.environ['PBS_JOBID'],
    'generated_at': datetime.now(timezone.utc).isoformat(),
    'flash_attn': importlib.metadata.version('flash_attn'),
    'torch': torch.__version__, 'cuda': torch.version.cuda,
    'gpu_native_inference_tested': False,
}, indent=2) + '\n')
READY
