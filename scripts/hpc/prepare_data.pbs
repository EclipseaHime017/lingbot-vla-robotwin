#!/bin/bash
# Submit from the repository with qsub -P personal and the environment dependency.
#PBS -N lrvla-data
#PBS -q normal
#PBS -l select=1:ncpus=4:mem=16gb
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -m n
set -euo pipefail
umask 077
: "${PBS_JOBID:?Submit data preparation through PBS}"
: "${PBS_O_WORKDIR:?PBS submission directory is missing}"
cd "$PBS_O_WORKDIR"
LRVLA_PREP_LOG_DIR="$PBS_O_WORKDIR/artifacts/pbs-data"
mkdir -p "$LRVLA_PREP_LOG_DIR"
exec >> "$LRVLA_PREP_LOG_DIR/${PBS_JOBID}.log" 2>&1
printf 'Preparing all clean tasks; PBS_JOBID=%s\n' "$PBS_JOBID"
hostname
export CONDA_ROOT="${CONDA_ROOT:-$HOME/miniconda3}"
export OMP_NUM_THREADS=4
export MKL_NUM_THREADS=4
export OPENBLAS_NUM_THREADS=4
export PYTHONUNBUFFERED=1
source scripts/activate.sh lingbot-vla
"${CONDA_PREFIX}/bin/python" - <<'LRVLA_RESET_MARKER'
from pathlib import Path
Path("data/SUCCESS.marker").unlink(missing_ok=True)
LRVLA_RESET_MARKER
"${CONDA_PREFIX}/bin/python" scripts/prepare_data.py --tasks all --val-episodes 5
"${CONDA_PREFIX}/bin/python" - <<'LRVLA_DATA_READY'
from datetime import datetime, timezone
import json
import os
from pathlib import Path
from lrvla.data import load_manifest

manifest = load_manifest(Path("data/clean_manifest.json"))
norm = json.loads(Path("data/clean_norm_stats.json").read_text())
provenance = json.loads(Path("data/clean_norm_stats.provenance.json").read_text())
assert manifest["complete_50_tasks"] and len(manifest["datasets"]) == 50
assert manifest["total_episodes"] == 2500
assert norm["count"] > 0 and norm["count"] == provenance["count"]
assert provenance["train_episode_ids"] == list(range(45))
assert provenance["val_episode_ids"] == list(range(45, 50))
report = {
    "status": "ready", "job_id": os.environ["PBS_JOBID"],
    "completed_utc": datetime.now(timezone.utc).isoformat(),
    "tasks": len(manifest["datasets"]), "episodes": manifest["total_episodes"],
    "training_frames": norm["count"],
    "frames": sum(entry["frames"] for entry in manifest["datasets"]),
    "manifest": str(Path("data/clean_manifest.json").resolve()),
    "norm_stats": str(Path("data/clean_norm_stats.json").resolve()),
}
Path("data/SUCCESS.marker").write_text(json.dumps(report, indent=2) + "\n")
print(json.dumps(report), flush=True)
LRVLA_DATA_READY
